        },
        "id": "91341d0b"
      },
      "source": [
        "### Step 2 --- A helper that scores a model both ways\n",
        "\n",
        "We will do the same two measurements many times today, so write\n",
        "them once. This function returns the training MAE, the test MAE,\n",
        "and the gap between them."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 4,
      "id": "c7bcb351",
      "metadata": {
        "scse3040": {
          "kind": "step",
          "n": 2
        },
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 0
        },
        "id": "c7bcb351",
        "outputId": "4260a089-54e4-46f0-ada1-9cb016bee2f5"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "helper ready\n"
          ]
        }
      ],
      "source": [
        "from sklearn.metrics import mean_absolute_error\n",
        "\n",
        "def score_both_ways(model, name):\n",
        "    \"\"\"Train the model, then score it on train and on test.\"\"\"\n",
        "    model.fit(X_train, y_train)\n",
        "    train_mae = mean_absolute_error(y_train, model.predict(X_train))\n",
        "    test_mae = mean_absolute_error(y_test, model.predict(X_test))\n",
        "    gap = test_mae - train_mae\n",
        "    print(f\"{name:<26} train {train_mae:5.2f}   \"\n",
        "          f\"test {test_mae:5.2f}   gap {gap:5.2f}\")\n",
        "    return {\"name\": name, \"train\": train_mae,\n",
        "            \"test\": test_mae, \"gap\": gap}\n",
        "\n",
        "print(\"helper ready\")"
      ]
    },
