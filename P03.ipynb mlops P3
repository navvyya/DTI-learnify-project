          ]
        }
      ],
      "source": [
        "from sklearn.tree import DecisionTreeRegressor\n",
        "\n",
        "wild_tree = score_both_ways(\n",
        "    DecisionTreeRegressor(random_state=42), \"DecisionTree (no limit)\"\n",
        ")"
      ]
